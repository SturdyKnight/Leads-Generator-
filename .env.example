# B-Matrix configuration. Copy to .env and fill in.
#
# There is no authentication by design — this is a single-operator tool. If you
# deploy it publicly, restrict access at the platform layer and lock the Google
# API key to your own referrer or IP.

NODE_ENV=development
PORT=4000
API_PREFIX=/api

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000

# PostgreSQL. In production, use the connection string from your host.
DATABASE_URL=postgresql://postgres:password@localhost:5432/bmatrix

# Google Places API (New). Required in production; discovery fails without it.
# Restrict the key to the Places API before deploying.
GOOGLE_PLACES_API_KEY=AIzaSyDc7YX0Lu4Dis8R2603XAnobcC7L_FsD54

# Optional. Enables radius-limited search — needs the Geocoding API enabled.
# Falls back to GOOGLE_PLACES_API_KEY when unset.
GOOGLE_GEOCODING_API_KEY=

# MiMo AI — optional. Enables chain classification, website intel, and outreach drafts.
# All features degrade gracefully when not set.
MIMO_API_KEY=sk-sczz0c5jblececspqegpuo8vye3zvd74qt1p60rkupf49b7p
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_MODEL=mimo-v2.5-pro

# Rate limiting, applied in production only.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=600

# error | warn | info | http | debug
LOG_LEVEL=info

# --- Frontend ---------------------------------------------------------------
# Base URL of the API. Leave unset in development to use the Vite proxy.
# VITE_API_URL=https://your-api.onrender.com/api
